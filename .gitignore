# Ignore everything by default
*

# Allow these files/folders
!.gitignore
!web
!web/**
!README.md
!public
!public/**
!index.html
!package.json
!package-lock.json
!tsconfig.json
!tailwind.config.js
!postcss.config.js
!vercel.json
!src
!src/**

# Node artifacts anywhere (extra safety if web/ nested installs leave traces)
**/node_modules/
**/.env*
**/.DS_Store
**/dist/
**/.vercel


